[Unit]
Description=Process pending exercise-rpg sessions
After=network.target

[Service]
Type=oneshot
User=exercise-rpg
Group=exercise-rpg
WorkingDirectory=/opt/exercise-rpg
EnvironmentFile=/etc/exercise-rpg/exercise-rpg.env
ExecStart=/opt/exercise-rpg/.venv/bin/python /opt/exercise-rpg/scripts/process_sessions.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/exercise-rpg
