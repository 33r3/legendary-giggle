[Unit]
Description=Exercise RPG ingest service
After=network.target

[Service]
Type=simple
User=exercise-rpg
Group=exercise-rpg
WorkingDirectory=/opt/exercise-rpg
EnvironmentFile=/etc/exercise-rpg/exercise-rpg.env
ExecStart=/opt/exercise-rpg/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/exercise-rpg

[Install]
WantedBy=multi-user.target
